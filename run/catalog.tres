[resource]
script = ExtResource("1_catalog")
items = Array[ExtResource("2_item")]([ExtResource("i_pistol"), ExtResource("i_shotgun"), ExtResource("i_rifle"), ExtResource("i_magnum"), ExtResource("i_ammo_vest"), ExtResource("i_armour_vest"), ExtResource("i_stim"), ExtResource("i_extended_mag")])
contracts = Array[ExtResource("3_contract")]([ExtResource("c_open_gate"), ExtResource("c_first_blood"), ExtResource("c_wardens_errand"), ExtResource("c_long_night"), ExtResource("c_main_event")])
sponsors = Array[ExtResource("4_sponsor")]([ExtResource("s_marksman"), ExtResource("s_butcher"), ExtResource("s_purist"), ExtResource("s_warden")])
