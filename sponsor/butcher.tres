[gd_resource type="Resource" script_class="SponsorData" load_steps=5 format=3]

[ext_resource type="Script" path="res://sponsor/sponsor_data.gd" id="1_data"]
[ext_resource type="Script" path="res://pod/pod_data.gd" id="2_pod"]
[ext_resource type="Resource" path="res://pod/pod_mag.tres" id="3_mag"]
[ext_resource type="Resource" path="res://pod/pod_fire_rate.tres" id="4_rate"]

[resource]
script = ExtResource("1_data")
